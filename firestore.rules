rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio content: anyone can read, only the admin account can write.
    match /content/site {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "roodterveus@gmail.com";
    }

    // Everything else stays locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
